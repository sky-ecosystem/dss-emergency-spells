{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sky-ecosystem/dss-emergency-spells/deployments/v2.schema.json",
  "title": "Emergency Spells V2 deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "chainId", "architecture", "records"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "chainId": { "type": "integer", "minimum": 1 },
    "architecture": { "const": "emergency-spells-v2" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["pending", "approved", "rejected", "not-applicable"]
        },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transactionHash", "blockNumber", "constructorArguments"],
      "properties": {
        "transactionHash": { "$ref": "#/$defs/bytes32" },
        "blockNumber": { "type": "integer", "minimum": 1 },
        "constructorArguments": {
          "type": "string",
          "pattern": "^0x([0-9a-fA-F]{2})*$"
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "leaves",
        "configHash",
        "factory",
        "getterReadbacks",
        "factoryEventVerified",
        "atomicSimulation"
      ],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "leaves": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/address" }
        },
        "configHash": { "$ref": "#/$defs/bytes32" },
        "factory": { "$ref": "#/$defs/address" },
        "getterReadbacks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "leaves", "configHash"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "leaves": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/address" }
            },
            "configHash": { "$ref": "#/$defs/bytes32" }
          }
        },
        "factoryEventVerified": { "type": "boolean" },
        "atomicSimulation": { "$ref": "#/$defs/simulation" }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reference",
        "chainId",
        "blockNumber",
        "batch",
        "configHash",
        "chief",
        "chiefAuthorizationVerified",
        "downstreamCallerVerified",
        "atomicRollbackVerified"
      ],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "reference": { "type": "string", "minLength": 1 },
        "chainId": { "type": "integer", "minimum": 1 },
        "blockNumber": { "type": "integer", "minimum": 1 },
        "batch": { "$ref": "#/$defs/address" },
        "configHash": { "$ref": "#/$defs/bytes32" },
        "chief": { "$ref": "#/$defs/address" },
        "chiefAuthorizationVerified": { "type": "boolean" },
        "downstreamCallerVerified": { "type": "boolean" },
        "atomicRollbackVerified": { "type": "boolean" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractName",
        "artifact",
        "kind",
        "address",
        "runtimeCodehash",
        "sourceCommit",
        "deployment",
        "immutableReadbacks",
        "subjects",
        "parameters",
        "reviews",
        "batchEligible",
        "operationalStatus"
      ],
      "properties": {
        "contractName": { "type": "string", "minLength": 1 },
        "artifact": {
          "type": "string",
          "pattern": "^src/[A-Za-z0-9_./-]+\\.sol:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "kind": {
          "enum": ["leaf", "registry-global", "batch", "infrastructure"]
        },
        "address": { "$ref": "#/$defs/address" },
        "runtimeCodehash": { "$ref": "#/$defs/bytes32" },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "deployment": { "$ref": "#/$defs/deployment" },
        "immutableReadbacks": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "subjects": { "type": "object" },
        "parameters": { "type": "object" },
        "reviews": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directUse", "batchUse"],
          "properties": {
            "directUse": { "$ref": "#/$defs/review" },
            "batchUse": { "$ref": "#/$defs/review" }
          }
        },
        "batchEligible": { "type": "boolean" },
        "operationalStatus": {
          "enum": ["deployed", "reviewed", "incident-ready", "revoked", "superseded"]
        },
        "batch": { "$ref": "#/$defs/batch" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "batch" } } },
          "then": { "required": ["batch"] }
        }
      ]
    }
  }
}
