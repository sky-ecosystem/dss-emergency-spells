{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sky-ecosystem/dss-emergency-spells/deployments/v1-migration.schema.json",
  "title": "Emergency Spells V1 to V2 migration status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "architecture",
    "sourceSnapshot",
    "v2ManifestPath",
    "statusSemantics",
    "counts",
    "records"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "chainId": { "type": "integer", "minimum": 1 },
    "architecture": { "const": "v1-to-v2-migration" },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "tag", "commit"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "v2ManifestPath": { "type": "string", "minLength": 1 },
    "statusSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiting-for-reviewed-v2-replacement",
        "deprecated-v1",
        "revoked-v1",
        "superseded-by-v2",
        "retained-v1-exception"
      ],
      "properties": {
        "waiting-for-reviewed-v2-replacement": { "type": "string", "minLength": 1 },
        "deprecated-v1": { "type": "string", "minLength": 1 },
        "revoked-v1": { "type": "string", "minLength": 1 },
        "superseded-by-v2": { "type": "string", "minLength": 1 },
        "retained-v1-exception": { "type": "string", "minLength": 1 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waitingForReviewedV2Replacement",
        "deprecatedV1",
        "revokedV1",
        "supersededByV2",
        "retainedV1Exception",
        "total"
      ],
      "properties": {
        "waitingForReviewedV2Replacement": { "type": "integer", "minimum": 0 },
        "deprecatedV1": { "type": "integer", "minimum": 0 },
        "revokedV1": { "type": "integer", "minimum": 0 },
        "supersededByV2": { "type": "integer", "minimum": 0 },
        "retainedV1Exception": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "coverageReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "legacyAddress",
        "legacyName",
        "legacyKind",
        "legacySubject",
        "legacyParameter",
        "replacementAddress",
        "replacementContractName",
        "replacementSubjects",
        "replacementParameters",
        "intendedCoverage"
      ],
      "properties": {
        "status": { "const": "approved" },
        "evidence": { "type": "string", "minLength": 1 },
        "legacyAddress": { "$ref": "#/$defs/address" },
        "legacyName": { "type": "string", "minLength": 1 },
        "legacyKind": { "type": "string", "minLength": 1 },
        "legacySubject": { "type": ["string", "null"] },
        "legacyParameter": { "type": ["string", "null"] },
        "replacementAddress": { "$ref": "#/$defs/address" },
        "replacementContractName": { "type": "string", "minLength": 1 },
        "replacementSubjects": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "replacementParameters": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "intendedCoverage": { "type": "string", "minLength": 1 }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "contractName", "coverageReview"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "contractName": { "type": "string", "minLength": 1 },
        "coverageReview": { "$ref": "#/$defs/coverageReview" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "address",
        "legacySnapshotStatus",
        "migrationStatus",
        "owner",
        "ownerEvidence",
        "evidence"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "parameter": { "type": "string", "minLength": 1 },
        "address": { "$ref": "#/$defs/address" },
        "legacySnapshotStatus": { "enum": ["active", "deprecated"] },
        "migrationStatus": {
          "enum": [
            "waiting-for-reviewed-v2-replacement",
            "deprecated-v1",
            "revoked-v1",
            "superseded-by-v2",
            "retained-v1-exception"
          ]
        },
        "owner": { "type": "string", "minLength": 1 },
        "ownerEvidence": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "replacement": { "$ref": "#/$defs/replacement" },
        "retentionRationale": { "type": "string", "minLength": 1 },
        "revocationReason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "legacySnapshotStatus": { "const": "deprecated" } },
            "required": ["legacySnapshotStatus"]
          },
          "then": { "properties": { "migrationStatus": { "const": "deprecated-v1" } } }
        },
        {
          "if": {
            "properties": { "legacySnapshotStatus": { "const": "active" } },
            "required": ["legacySnapshotStatus"]
          },
          "then": {
            "properties": {
              "migrationStatus": {
                "enum": [
                  "waiting-for-reviewed-v2-replacement",
                  "revoked-v1",
                  "superseded-by-v2",
                  "retained-v1-exception"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "migrationStatus": { "const": "superseded-by-v2" } },
            "required": ["migrationStatus"]
          },
          "then": { "required": ["replacement"] },
          "else": { "not": { "required": ["replacement"] } }
        },
        {
          "if": {
            "properties": { "migrationStatus": { "const": "retained-v1-exception" } },
            "required": ["migrationStatus"]
          },
          "then": { "required": ["retentionRationale"] },
          "else": { "not": { "required": ["retentionRationale"] } }
        },
        {
          "if": {
            "properties": { "migrationStatus": { "const": "revoked-v1" } },
            "required": ["migrationStatus"]
          },
          "then": { "required": ["revocationReason"] },
          "else": { "not": { "required": ["revocationReason"] } }
        }
      ]
    }
  }
}
